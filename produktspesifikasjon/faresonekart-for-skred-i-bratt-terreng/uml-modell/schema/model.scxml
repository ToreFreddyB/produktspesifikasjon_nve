         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeName>Integer</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>geometri</sc:name>
         <sc:id>C2_5</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>registreres geometri</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
