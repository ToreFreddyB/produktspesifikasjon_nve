    <sc:Class>
     <sc:name>Kommunenummer</sc:name>
     <sc:id>C13</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>nummerering av kommunen i henhold til Statistisk sentralbyrå sin offisielle liste Merknad: Det presiseres at kommune alltid skal ha 4 siffer, dvs. eventuelt med ledende null. Kommune benyttes for kopling mot en rekke andre registre som også benytter 4 siffer
Merknad: Her angis den kommune som utgjør det største arealet

English definition:
Numbering of municipalities according to Statistics Norway’s official list.
Note: The municipality number must always consist of four digits, including leading zeros if necessary. Municipality numbers are used for linking to various other registers that also use four-digit codes</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>https://register.geonorge.no/sosi-kodelister/inndelinger/inndelingsbase/kommunenummer</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
    </sc:Class>
    <sc:Class>
     <sc:name>Fylkesnummer</sc:name>
     <sc:id>C14</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>&lt;font color="#333333"&gt;nummerering av fylker i henhold til Statistisk sentralbyrå sin offisielle liste &lt;/font&gt;
&lt;font color="#333333"&gt;Merknad: Det presiseres at fylkesnummer alltid skal ha 2 sifre, dvs. eventuelt med ledende null. Fylkesnummer benyttes for kopling mot en rekke andre registre som også benytter 2 sifre&lt;/font&gt;
&lt;font color="#333333"&gt;Merknad: Her angis det fylket som utgjør det største arealet&lt;/font&gt;
&lt;font color="#333333"&gt;
&lt;/font&gt;&lt;font color="#333333"&gt;English definition:&lt;/font&gt;
&lt;font color="#333333"&gt;Numbering of counties according to Statistics Norway’s official list. &lt;/font&gt;
&lt;font color="#333333"&gt;Note: The county number must always consist of two digits, including a leading zero if necessary. County numbers are used for linking to various other registers that also use two-digit codes&lt;/font&gt;</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>https://register.geonorge.no/sosi-kodelister/inndelinger/inndelingsbase/fylkesnummer</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
    </sc:Class>
   </sc:classes>
   <sc:packages>
    <sc:Package>
     <sc:name>FaresonekartForSkredIBrattTerreng-1.0</sc:name>
     <sc:id>P2</sc:id>
     <sc:classes>
      <sc:Class>
       <sc:name>Påvirkningsområde</sc:name>
       <sc:id>C1</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>området som kan generere skred inn mot kartleggingsområdet/analyseområdet.

English definition:
The area that may generate avalanches and/or landslides toward the mapping area/analysis area</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C4</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>utførende</sc:name>
         <sc:id>C1_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>selskapet eller organisasjonen som har gjennomført utredningen, det vil si skrevet rapporten og gjort vurderingene av naturfare

English definition:
The company or organization that has carried out the assessment, i.e., prepared the report and conducted the evaluations of natural hazards</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>UTFØRENDE</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>rapportURL</sc:name>
         <sc:id>C1_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>URL-lenke til rapport som dokumenterer utredningen av skredfare

English definition:
URL link to the report documenting the avalanche hazard assessment</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>RAPPORTURL</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>geometri</sc:name>
         <sc:id>C1_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>Registreres geometri</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>GEOMETRI</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeName>GM_Surface</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>påvirkningsområdeID</sc:name>
         <sc:id>C1_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>identifikasjon påvirkningsområde

English definition
Påvirkningsområde identification</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>PÅVIRKNINGSOMRÅDEID</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeId>C6</sc:typeId>
         <sc:typeName>Identifikasjon</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
      <sc:Class>
       <sc:name>Skredfaresone</sc:name>
       <sc:id>C2</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Område med reell skredfare, for angitt skredsannsynlighet og skredtype

English definition:
An area with actual avalanche and landslide hazard, defined by a specified avalanche/landslide probability and type</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C4</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>skredtype</sc:name>
         <sc:id>C2_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>hvilke skredmasser som er forbundet med skredfaren eller skredhendelsen
Merknad: Ulike typer skredmasser som bl.a. stein, snø, fjell, jord og kombinasjoner av disse

English definition:
Specifies the type of avalanche and/or landslide material associated with the hazard or avalanche event.
Note: Different types of avalanche material may include rock, snow, bedrock, soil, or combinations of these</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SKREDTYPE</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C8</sc:typeId>
         <sc:typeName>SkredtypeDetaljert</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>skredSannsynlighet</sc:name>
         <sc:id>C2_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>statistisk sannsynlighet for at det går et skred i området pr år

English definition:
The statistical probability of an avalanche occurring in the area per year</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SKREDSANNSYNLIGHET</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C9</sc:typeId>
         <sc:typeName>SkredSannsynlighetBrattTerreng</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>skredfaresoneID</sc:name>
         <sc:id>C2_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>skredfaresone identifikasjon

English definition:
Avalanche and landslide hazard zone identification</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SKREDFARESONEID</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeId>C6</sc:typeId>
         <sc:typeName>Identifikasjon</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>analyseområdeNummer</sc:name>
         <sc:id>C2_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>løpenummer for analyseområdene. Unikt nummer for analyseområdene innenfor de enkelte faretemaene

English definition:
A sequential number assigned to the analysed areas. This is a unique identifier for each analysis area within the respective hazard themes</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>ANALYSEOMRÅDENUMMER</sc:Value>
           </sc:values>
          </sc:TaggedValue>
